# Copia este archivo a .env y ajusta los valores.
# La aplicación rechaza los valores de ejemplo de este archivo: cambia SECRET
# y ADMIN_PASS (o usa ADMIN_PASS_HASH) antes de arrancar.
# Genera un secreto con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"

SECRET=cambia-este-secreto-por-uno-aleatorio-de-64-caracteres

ADMIN_USER=coordinador
# Recomendado: define solo el hash (la app nunca ve la contraseña en claro).
# Genera el hash dentro del contenedor con:
#   docker compose run --rm sad python -c "from werkzeug.security import generate_password_hash as g; print(g('TU_CONTRASEÑA'))"
# ADMIN_PASS_HASH=scrypt:32768:8:1$...

# Alternativa de desarrollo: contraseña en claro (la app la hashea al arrancar).
ADMIN_PASS=cambia-esto-por-una-contraseña-fuerte

# 0 en desarrollo local por HTTP; 1 cuando sirvas la app por HTTPS.
COOKIE_SECURE=0

MAX_UPLOAD_MB=25
MAX_TEXT_KB=512
MAX_VERSIONS=10
LOCK_TTL=90
ONLINE_WINDOW=30
SESSION_LIFETIME_H=8

# No lo actives en producción.
ALLOW_INSECURE_DEFAULTS=0

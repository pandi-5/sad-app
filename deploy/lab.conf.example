# Configuración del laboratorio de archivos distribuidos.
# setup.sh la copia a /etc/sad-lab/lab.conf la primera vez. Edítala allí.
# Todos los nodos deben usar exactamente los mismos valores.

# ---------- Nodos ----------
# El orden de SERVERS es el orden de sucesión. Si cae el primario asume el siguiente vivo
# que tenga los datos al día.
SERVERS="servidor-a servidor-b servidor-c servidor-d"
CLIENTS="cliente-1 cliente-2 cliente-3"

# ---------- Consenso con etcd ----------
# Nodos que forman el clúster etcd, que usa Raft. Con cinco miembros la mayoría es tres y
# aguanta que se apaguen dos. Si se apagan tres, nadie puede ser primario y todo queda en
# solo lectura. Vacío usa los clientes más los últimos servidores, hasta cinco.
ETCD_MEMBERS="cliente-1 cliente-2 cliente-3 servidor-c servidor-d"
# Segundos del contrato del primario. Si no lo renueva, vence y otro asume. A un tercio de
# este tiempo sin contacto con la mayoría, el primario se pone solo en solo lectura.
LEASE_TTL=6
# Segundos que espera cada servidor por cada puesto que tiene delante en la sucesión.
RANK_DELAY=2
# Si en estos segundos no asume ningún servidor con los datos del último primario, se
# permite que asuma uno con datos más viejos.
STALE_GRACE=30

# Usuario Linux común que setup.sh crea en todos los nodos. Debe ser el mismo en todos.
LAB_USER="sadlab"
# Clave de ese usuario. Solo se usa para el primer intercambio de llaves SSH.
SSH_PASSWORD="CambiaEstaClave123"
# Carpeta donde setup.sh instala el proyecto en cada nodo. Igual en todos.
APP_DIR=/opt/sad-app

# ---------- Red privada superpuesta ----------
# real  Tailscale real. Cada nodo se une a la misma red de Tailscale y setup.sh
#       escribe en /etc/hosts la IP de cada nodo, sin depender de MagicDNS.
# sim   Simula Tailscale con la interfaz tssim0. Solo para VM en un mismo equipo.
# none  Sin red superpuesta. Los nodos se hablan por las direcciones LAN.
OVERLAY_MODE=real
# Llave de autorización de Tailscale, reutilizable. Se crea en
# https://login.tailscale.com/admin/settings/keys. Vacía pide autorizar con un enlace.
TS_AUTHKEY=""
# Opcional. Fija a mano la IP de Tailscale de un nodo si no aparece con su nombre.
# TSIP_A=100.101.102.103
# TSIP_C1=100.101.102.104

# Direcciones solo para OVERLAY_MODE=sim
OV_A=100.64.0.11
OV_B=100.64.0.12
OV_C=100.64.0.13
OV_D=100.64.0.14
OV_C1=100.64.0.21
OV_C2=100.64.0.22
OV_C3=100.64.0.23

# Direcciones solo para OVERLAY_MODE=sim o none, segunda tarjeta de VirtualBox
LAN_A=192.168.56.11
LAN_B=192.168.56.12
LAN_C=192.168.56.13
LAN_D=192.168.56.14
LAN_C1=192.168.56.21
LAN_C2=192.168.56.22
LAN_C3=192.168.56.23
LAN_CIDR=24
LAN_CONFIGURE=yes

# ---------- Carpeta compartida ----------
EXPORT_DIR=/srv/compartido
# En los clientes. Escritura, montada desde el primario.
MOUNT_DIR=/mnt/compartido
# En los clientes. Solo lectura, montada desde la réplica más cercana.
READ_MOUNT_DIR=/mnt/lectura

# ---------- Aplicación web ----------
APP_PORT=5000
AGENT_PORT=5100
ADMIN_USER=coordinador
# Vacío genera una contraseña aleatoria que se guarda en /etc/sad-lab/credenciales.txt
ADMIN_PASS=""
# Usuarios de prueba con permiso de lectura y escritura, formato usuario:clave separados por comas.
SEED_USERS="cliente1:ClaveCliente123,cliente2:ClaveCliente456,cliente3:ClaveCliente789"

# ---------- Réplica y conmutación ----------
# El replicador copia apenas cambia un archivo. Este es el máximo entre latidos.
REPL_INTERVAL=2

# ---------- Fotos con historial ----------
# Servidores que guardan fotos de la carpeta. Vacío usa todos los servidores.
SNAPSHOT_NODES=""
# Minutos entre fotos y cuántas se conservan. 15 y 96 son las últimas 24 horas.
SNAPSHOT_EVERY=15
SNAPSHOT_KEEP=96

# yes permite sudo sin contraseña al usuario del laboratorio, necesario para failback.
SUDO_NOPASSWD=yes

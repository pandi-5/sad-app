# Configuración común del laboratorio. Edita estas variables en cada equipo.
# Usa la IP de Tailscale (tailscale ip -4) o el nombre MagicDNS de cada servidor.
SERVIDOR_A=100.x.x.x
SERVIDOR_B=100.y.y.y

# Usuario de WSL en los servidores (se usa para rsync por SSH)
USUARIO=${USER:-$(whoami)}

# Carpeta compartida en los servidores y punto de montaje en los clientes
EXPORT_DIR=/srv/compartido
MOUNT_DIR=/mnt/compartido

# Segundos entre sincronizaciones A -> B
INTERVALO_REPLICA=2
